body {
  margin: 0;
  background: #0f0f0f;
  color: #00ff9d;
  font-family: monospace;
}

.container {
  width: 600px;
  margin: auto;
  padding: 20px;
}

h1 {
  text-align: center;
}

.subtitle {
  text-align: center;
  opacity: 0.6;
}

#chat {
  background: #111;
  height: 300px;
  overflow-y: auto;
  padding: 10px;
  border: 1px solid #00ff9d;
}

.msg {
  margin: 5px 0;
}

.user {
  color: #00aaff;
}

.elgoog {
  color: #ffcc00;
}

textarea {
  width: 100%;
  height: 60px;
  background: black;
  color: white;
  border: 1px solid #00ff9d;
}

button {
  margin-top: 5px;
  padding: 10px;
  width: 100%;
  background: #00ff9d;
  border: none;
  cursor: pointer;
}
